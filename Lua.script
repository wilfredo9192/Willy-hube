end)

-- ESP (same as last working)
local ESPData = {}

local function getWeapon(char)
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool.Name end
    return nil
end

local function cleanup(plr)
    if ESPData[plr] then
        if ESPData[plr].bill and ESPData[plr].bill.Parent then ESPData[plr].bill:Destroy() end
        ESPData[plr] = nil
    end
    if plr.Character then
        local sb = plr.Character:FindFirstChild("WillySB")
        if sb then sb:Destroy() end
        local hl = plr.Character:FindFirstChild("WillyHL")
        if hl then hl:Destroy() end
    end
end

local function setupPlayer(plr)
    if plr == LocalPlayer then return end
    cleanup(plr)

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 160, 0, 55)
    bill.StudsOffset = Vector3.new(0, 3.6, 0)
    bill.AlwaysOnTop = true
    bill.MaxDistance = 800
    bill.Parent = ScreenGui

    local nameL = Instance.new("TextLabel")
    nameL.Name = "Name"
    nameL.Size = UDim2.new(1, 0, 0, 16)
    nameL.BackgroundTransparency = 1
    nameL.Text = plr.DisplayName or plr.Name
    nameL.TextColor3 = Theme.Accent
    nameL.TextStrokeTransparency = 0.15
    nameL.Font = Enum.Font.GothamBold
    nameL.TextSize = 13
    nameL.Parent = bill

    local distL = Instance.new("TextLabel")
    distL.Name = "Dist"
    distL.Size = UDim2.new(1, 0, 0, 13)
    distL.Position = UDim2.new(0, 0, 0, 15)
    distL.BackgroundTransparency = 1
    distL.Text = ""
    distL.TextColor3 = Theme.Text
    distL.TextStrokeTransparency = 0.3
    distL.Font = Enum.Font.Gotham
    distL.TextSize = 11
    distL.Parent = bill

    local wepL = Instance.new("TextLabel")
    wepL.Name = "Wep"
    wepL.Size = UDim2.new(1, 0, 0, 13)
    wepL.Position = UDim2.new(0, 0, 0, 27)
    wepL.BackgroundTransparency = 1
    wepL.Text = ""
    wepL.TextColor3 = Theme.Weapon
    wepL.TextStrokeTransparency = 0.25
    wepL.Font = Enum.Font.GothamBold
    wepL.TextSize = 11
    wepL.Parent = bill

    local hBG = Instance.new("Frame")
    hBG.Name = "HBG"
    hBG.Size = UDim2.new(0.8, 0, 0, 5)
    hBG.Position = UDim2.new(0.1, 0, 0, 43)
    hBG.BackgroundColor3 = Color3.fromRGB(25,25,30)
    hBG.BorderSizePixel = 0
    hBG.Parent = bill
    Instance.new("UICorner", hBG).CornerRadius = UDim.new(1, 0)

    local hBar = Instance.new("Frame")
    hBar.Name = "Bar"
    hBar.Size = UDim2.new(1, 0, 1, 0)
    hBar.BackgroundColor3 = Theme.Accent
    hBar.BorderSizePixel = 0
    hBar.Parent = hBG
    Instance.new("UICorner", hBar).CornerRadius = UDim.new(1, 0)

    ESPData[plr] = {bill = bill, name = nameL, dist = distL, wep = wepL, hbg = hBG, bar = hBar}

    local function onChar(char)
        task.wait(0.35)
        if not char or not char.Parent then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
        if root then bill.Adornee = root end

        local sb = char:FindFirstChild("WillySB")
        if not sb then
            sb = Instance.new("SelectionBox")
            sb.Name = "WillySB"
            sb.LineThickness = 0.06
            sb.Color3 = Theme.Accent
            sb.SurfaceTransparency = 0.8
            sb.SurfaceColor3 = Theme.Accent
            sb.Adornee = char
            sb.Parent = char
        end

        local hl = char:FindFirstChild("WillyHL")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "WillyHL"
            hl.FillTransparency = 0.72
            hl.OutlineTransparency = 0
            hl.OutlineColor = Theme.Accent
            hl.FillColor = Theme.Accent
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end
    end

    if plr.Character then onChar(plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(cleanup)

-- Noclip + Fly + SuperJump
local flyBV = nil
local noclipConn = nil

local function getChar()
    return LocalPlayer.Character
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Noclip loop
RunService.Stepped:Connect(function()
    if Settings.Noclip then
        local char = getChar()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- Super Jump
local oldJump = nil
RunService.Heartbeat:Connect(function()
    local hum = getHum()
    if hum then
        if Settings.SuperJump then
            hum.JumpPower = 120
            hum.JumpHeight = 50
        else
            hum.JumpPower = 50
            hum.JumpHeight = 7.2
        end
    end
end)

-- Fly
local keys = {W=false, A=false, S=false, D=false, Up=false, Down=false}
UserInputService.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.W then keys.W = true end
    if i.KeyCode == Enum.KeyCode.A then keys.A = true end
    if i.KeyCode == Enum.KeyCode.S then keys.S = true end
    if i.KeyCode == Enum.KeyCode.D then keys.D = true end
    if i.KeyCode == Enum.KeyCode.Space then keys.Up = true end
    if i.KeyCode == Enum.KeyCode.LeftControl then keys.Down = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.W then keys.W = false end
    if i.KeyCode == Enum.KeyCode.A then keys.A = false end
    if i.KeyCode == Enum.KeyCode.S then keys.S = false end
    if i.KeyCode == Enum.KeyCode.D then keys.D = false end
    if i.KeyCode == Enum.KeyCode.Space then keys.Up = false end
    if i.KeyCode == Enum.KeyCode.LeftControl then keys.Down = false end
end)

-- Mobile fly controls (big buttons when fly on)
local FlyControls = Instance.new("Frame")
FlyControls.Size = UDim2.new(0, 140, 0, 140)
FlyControls.Position = UDim2.new(1, -160, 1, -200)
FlyControls.BackgroundTransparency = 1
FlyControls.Visible = false
FlyControls.Parent = ScreenGui

local function makeFlyBtn(text, pos, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 50, 0, 50)
    b.Position = pos
    b.BackgroundColor3 = Theme.Dark
    b.Text = text
    b.TextColor3 = Theme.Accent
    b.Font = Enum.Font.GothamBold
    b.TextSize = 16
    b.Parent = FlyControls
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
    b.MouseButton1Down:Connect(function() keys[key] = true end)
    b.MouseButton1Up:Connect(function() keys[key] = false end)
    return b
end

makeFlyBtn("↑", UDim2.new(0.5, -25, 0, 0), "Up")
makeFlyBtn("↓", UDim2.new(0.5, -25, 0, 90), "Down")
makeFlyBtn("W", UDim2.new(0.5, -25, 0, 45), "W")
makeFlyBtn("A", UDim2.new(0, 0, 0, 45), "A")
makeFlyBtn("D", UDim2.new(1, -50, 0, 45), "D")

RunService.RenderStepped:Connect(function(dt)
    FOVStroke.Color = Color3.fromHSV((tick()*0.5)%1, 1, 1)
    FOVFrame.Visible = Settings.ShowFOV
    FlyControls.Visible = Settings.Fly

    local root = getRoot()
    local hum = getHum()

    -- Fly
    if Settings.Fly and root and hum then
        hum.PlatformStand = true
        local camCF = Camera.CFrame
        local move = Vector3.zero
        if keys.W then move = move + camCF.LookVector end
        if keys.S then move = move - camCF.LookVector end
        if keys.A then move = move - camCF.RightVector end
        if keys.D then move = move + camCF.RightVector end
        if keys.Up then move = move + Vector3.new(0, 1, 0) end
        if keys.Down then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            move = move.Unit * Settings.FlySpeed
        end
        root.AssemblyLinearVelocity = move
    else
        if hum then hum.PlatformStand = false end
    end

    -- Aimbot
    if Settings.Aimbot and Settings.Holding then
        local closest, short = nil, Settings.FOV
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local r = plr.Character:FindFirstChild("HumanoidRootPart")
                local h = plr.Character:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local sp, on = Camera:WorldToViewportPoint(r.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < short then short = d closest = r end
                    end
                end
            end
        end
        if closest then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closest.Position), Settings.Smooth)
        end
    end

    -- ESP update
    local myRoot = getRoot()
    for plr, data in pairs(ESPData) do
        local char = plr.Character
        local hump = char and char:FindFirstChildOfClass("Humanoid")
        local r = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))

        if Settings.ESP and char and hump and hump.Health > 0 and r then
            data.bill.Enabled = true
            if data.bill.Adornee ~= r then data.bill.Adornee = r end

            if Settings.Name then
                data.name.Visible = true
                data.name.Text = plr.DisplayName or plr.Name
                if Settings.Distance and myRoot then
                    data.dist.Text = math.floor((r.Position - myRoot.Position).Magnitude) .. "m"
                    data.dist.Visible = true
                else data.dist.Visible = false end
            else
                data.name.Visible = false
                data.dist.Visible = false
            end

            if Settings.Weapon then
                local wep = getWeapon(char)
                data.wep.Text = wep and ("🔫 "..wep) or ""
                data.wep.Visible = wep ~= nil
            else data.wep.Visible = false end

            if Settings.Health then
                local pct = math.clamp(hump.Health / math.max(hump.MaxHealth, 1), 0, 1)
                data.hbg.Visible = true
                data.bar.Size = UDim2.new(pct, 0, 1, 0)
                data.bar.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 0.9, 1)
            else data.hbg.Visible = false end

            local sb = char:FindFirstChild("WillySB")
            if sb then sb.Visible = Settings.Box end
            local hl = char:FindFirstChild("WillyHL")
            if hl then hl.Enabled = Settings.Box end
        else
            data.bill.Enabled = false
            if char then
                local sb = char:FindFirstChild("WillySB")
                if sb then sb.Visible = false end
                local hl = char:FindFirstChild("WillyHL")
                if hl then hl.Enabled = false end
            end
        end
    end
end)

print("[WillyHub] Player page added - Noclip / SuperJump / Fly")
